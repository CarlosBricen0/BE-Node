{
  "name": "onlyhorse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-postgres.mjs",
    "db:local:stop": "node scripts/local-postgres.mjs --stop",
    "db:backup": "node scripts/backup-database.mjs",
    "db:backup:verify": "node scripts/backup-database.mjs --verify",
    "test:integration": "node scripts/test-database.mjs",
    "check:env": "tsx scripts/check-env.ts",
    "check:services": "tsx scripts/check-services.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "dotenv": "^16.6.1",
    "@prisma/client": "5.22.0",
    "cloudinary": "^2.9.0",
    "resend": "6.35.0"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^22",
    "@types/express": "^5.0.0"
  }
}
